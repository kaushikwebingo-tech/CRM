# Copy to .env and fill in. `chmod 600 .env` (Plan Section 12, "Secrets").

# --- required ---
# openssl rand -hex 32
SESSION_SECRET=
POSTGRES_PASSWORD=

# --- database and cache ---
# For local development against the compose stack:
DATABASE_URL=postgresql://crm:change-me@localhost:5432/crm
REDIS_URL=redis://localhost:6379

# --- app ---
PORT=9000
NODE_ENV=development

# Only needed when the SPA is served from a different origin than the API
# (the Vite dev server). In production Caddy serves both on one origin and this
# should be left empty.
CORS_ORIGIN=http://localhost:5173

# The timezone relative date filters ("today", "this_quarter") resolve against.
ORG_TIMEZONE=Asia/Kolkata

# --- limits ---
RATE_LIMIT_USER_PER_MIN=300
RATE_LIMIT_ORG_PER_MIN=3000
MAX_JSON_BODY=8mb
MAX_UPLOAD_BYTES=15728640

# --- seed ---
SEED_ADMIN_EMAIL=admin@webingo.com
SEED_ADMIN_PASSWORD=

# --- optional ---
# The site address Caddy binds to, e.g. crm.example.com. Defaults to :80.
CRM_SITE_ADDRESS=
# Set to 'true' only to run the outbox worker inside the API process as well.
RUN_OUTBOX_WORKER_IN_API=false
# Set to 'true' to allow webhooks to private addresses (local development only).
WEBHOOK_ALLOW_PRIVATE=false
